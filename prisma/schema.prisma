generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum RiskLevel {
  low
  medium
  high
}

enum LineTag {
  safe
  aggressive
  scramble
}

enum VoteValue {
  up
  down
}

enum CourseStatus {
  draft
  pending
  approved
  rejected
}

enum CourseEditProposalStatus {
  pending
  approved
  rejected
}

enum CourseDifficulty {
  beginner
  mixed
  challenging
  expert
}

enum CourseMarkType {
  played
  wantToPlay
}

enum ContentStatus {
  visible
  hidden
}

enum ModerationTargetType {
  courseReview
  holeReview
  line
  forumThread
  forumComment
}

enum ReportStatus {
  open
  resolved
}

enum ModerationActionType {
  hide
  restore
  delete
  resolve
}

enum NotificationType {
  coursePost
  courseEvent
}

enum NotificationTargetType {
  forumThread
  courseEvent
}

enum CourseEventType {
  leagueNight
  doubles
  tournament
  glowRound
  casualRound
  clinic
  tagsMatch
  puttingLeague
}

enum CourseEventVisibility {
  public
  unlisted
  private
}

enum CourseEventRsvpStatus {
  going
  interested
}

enum CourseEventRecurrenceFrequency {
  weekly
  biweekly
  monthly
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  profileImageUrl String?
  bio             String?
  homeCourseName  String?
  isAdmin         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  courseReviews                CourseReview[]
  holeReviews                  HoleReview[]
  lines                        Line[]
  submittedCourses             Course[]                @relation("SubmittedCourses")
  submittedCourseEditProposals CourseEditProposal[]    @relation("SubmittedCourseEditProposals")
  reviewedCourseEditProposals  CourseEditProposal[]    @relation("ReviewedCourseEditProposals")
  following                    Follow[]                @relation("Follower")
  followers                    Follow[]                @relation("Following")
  lineVotes                    LineVote[]
  sessions                     Session[]
  contentReports               ContentReport[]         @relation("ContentReporter")
  resolvedReports              ContentReport[]         @relation("ReportResolver")
  moderationActions            AdminModerationAction[] @relation("ModerationActor")
  courseMarks                  CourseMark[]
  courseLists                  CourseList[]
  forumThreads                 ForumThread[]
  forumComments                ForumComment[]
  forumCommentLikes            ForumCommentLike[]
  oauthAccounts                OauthAccount[]
  courseFollows                CourseFollow[]
  notifications                Notification[]          @relation("NotificationRecipient")
  authoredNotifications        Notification[]          @relation("NotificationActor")
  hostedCourseEvents           CourseEvent[]           @relation("HostedCourseEvents")
  courseEventRsvps             CourseEventRsvp[]
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model OauthAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model AuthRateLimit {
  id              Int       @id @default(autoincrement())
  action          String
  keyHash         String
  attempts        Int       @default(0)
  failures        Int       @default(0)
  blockedUntil    DateTime?
  windowStartedAt DateTime  @default(now())
  lastAttemptAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([action, keyHash])
  @@index([action, blockedUntil])
  @@index([updatedAt])
}

model Course {
  id               Int              @id @default(autoincrement())
  name             String
  locationName     String
  locationAddress  String?
  description      String?
  latitude         Float?
  longitude        Float?
  coverPhotoUrl    String?
  difficulty       CourseDifficulty @default(mixed)
  hasParking       Boolean          @default(false)
  hasBathrooms     Boolean          @default(false)
  hasWater         Boolean          @default(false)
  cartFriendly     Boolean          @default(false)
  dogFriendly      Boolean          @default(false)
  beginnerFriendly Boolean          @default(false)
  isPayToPlay      Boolean          @default(false)
  status           CourseStatus     @default(pending)
  layoutName       String?
  importSourceUrl  String?
  importWarnings   String[]         @default([])
  submittedById    Int?
  createdAt        DateTime         @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  holes         Hole[]
  layouts       CourseLayout[]
  editProposals CourseEditProposal[]
  reviews       CourseReview[]
  submittedBy   User?                @relation("SubmittedCourses", fields: [submittedById], references: [id], onDelete: SetNull)
  marks         CourseMark[]
  listItems     CourseListItem[]
  followers     CourseFollow[]
  forumThreads  ForumThread[]
  notifications Notification[]
  events        CourseEvent[]

  @@index([difficulty])
  @@index([status])
  @@index([submittedById])
}

model CourseFollow {
  id              Int      @id @default(autoincrement())
  userId          Int
  courseId        Int
  notifyNewPosts  Boolean  @default(true)
  notifyNewEvents Boolean  @default(true)
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
}

model CourseEditProposal {
  id            Int                      @id @default(autoincrement())
  courseId      Int
  submittedById Int?
  reviewedById  Int?
  status        CourseEditProposalStatus @default(pending)
  proposedData  Json
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  reviewedAt    DateTime?

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submittedBy User?  @relation("SubmittedCourseEditProposals", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?  @relation("ReviewedCourseEditProposals", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([submittedById, createdAt])
  @@index([status, createdAt])
}

model CourseLayout {
  id             Int      @id @default(autoincrement())
  courseId       Int
  name           String
  sortOrder      Int      @default(0)
  sourceLayoutId String?
  createdAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holes  Hole[]

  @@unique([courseId, name])
  @@index([courseId, sortOrder])
}

model CourseMark {
  id        Int            @id @default(autoincrement())
  courseId  Int
  userId    Int
  type      CourseMarkType
  createdAt DateTime       @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, type])
  @@index([userId, type])
  @@index([courseId, type])
}

model CourseList {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CourseListItem[]

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

model CourseListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  courseId  Int
  note      String?
  rank      Int
  createdAt DateTime @default(now())

  list   CourseList @relation(fields: [listId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([listId, courseId])
  @@index([courseId])
  @@index([listId, rank])
}

model Hole {
  id           Int      @id @default(autoincrement())
  courseId     Int
  layoutId     Int?
  holeNumber   Int
  par          Int?
  distanceFeet Int?
  description  String?
  teePhotoUrl  String?
  teeLat       Float?
  teeLng       Float?
  basketLat    Float?
  basketLng    Float?
  createdAt    DateTime @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  layout  CourseLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  reviews HoleReview[]
  lines   Line[]

  @@index([courseId])
  @@index([layoutId, holeNumber])
}

model CourseReview {
  id           Int           @id @default(autoincrement())
  courseId     Int
  userId       Int
  rating       Int
  title        String?
  body         String
  photoUrl     String?
  status       ContentStatus @default(visible)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

model HoleReview {
  id           Int           @id @default(autoincrement())
  holeId       Int
  userId       Int
  rating       Int
  title        String?
  body         String
  photoUrl     String?
  status       ContentStatus @default(visible)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  hole Hole @relation(fields: [holeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([holeId, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

model Line {
  id             Int           @id @default(autoincrement())
  holeId         Int
  userId         Int
  name           String
  description    String?
  difficulty     Difficulty
  riskLevel      RiskLevel
  tag            LineTag       @default(safe)
  discSuggestion String?
  upvotes        Int           @default(0)
  downvotes      Int           @default(0)
  status         ContentStatus @default(visible)
  hiddenAt       DateTime?
  hiddenReason   String?
  createdAt      DateTime      @default(now())

  hole  Hole       @relation(fields: [holeId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes LineVote[]

  @@index([holeId, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

model ForumThread {
  id           Int           @id @default(autoincrement())
  userId       Int
  courseId     Int?
  eventId      Int?          @unique
  title        String
  body         String
  flair        String?
  status       ContentStatus @default(visible)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  event    CourseEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  comments ForumComment[]
  photos   ForumThreadPhoto[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([courseId, status, createdAt])
  @@index([eventId])
}

model CourseEvent {
  id                  Int                             @id @default(autoincrement())
  title               String
  description         String
  hostId              Int
  courseId            Int
  type                CourseEventType
  startTime           DateTime
  endTime             DateTime?
  timezone            String                          @default("America/New_York")
  recurrenceFrequency CourseEventRecurrenceFrequency?
  recurrenceInterval  Int                             @default(1)
  recurrenceEndsAt    DateTime?
  maxPlayers          Int?
  visibility          CourseEventVisibility           @default(public)
  tags                String[]                        @default([])
  imageUrl            String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  host             User              @relation("HostedCourseEvents", fields: [hostId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rsvps            CourseEventRsvp[]
  discussionThread ForumThread?

  @@index([courseId, startTime])
  @@index([hostId, startTime])
  @@index([type, startTime])
  @@index([visibility, startTime])
}

model CourseEventRsvp {
  id        Int                   @id @default(autoincrement())
  eventId   Int
  userId    Int
  status    CourseEventRsvpStatus
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  event CourseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
}

model Notification {
  id             Int                    @id @default(autoincrement())
  userId         Int
  actorId        Int?
  courseId       Int
  type           NotificationType
  targetType     NotificationTargetType
  targetRecordId Int
  isRead         Boolean                @default(false)
  readAt         DateTime?
  createdAt      DateTime               @default(now())

  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor  User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetType, targetRecordId])
  @@index([userId, isRead, createdAt])
  @@index([courseId, type, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetRecordId])
}

model ForumThreadPhoto {
  id        Int      @id @default(autoincrement())
  threadId  Int
  url       String
  sortOrder Int
  createdAt DateTime @default(now())

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sortOrder])
}

model ForumComment {
  id              Int           @id @default(autoincrement())
  threadId        Int
  parentCommentId Int?
  userId          Int
  body            String
  likeCount       Int           @default(0)
  status          ContentStatus @default(visible)
  hiddenAt        DateTime?
  hiddenReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  thread        ForumThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentComment ForumComment?      @relation("ForumCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       ForumComment[]     @relation("ForumCommentReplies")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         ForumCommentLike[]

  @@index([threadId, createdAt])
  @@index([threadId, parentCommentId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model ForumCommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  userId    Int
  createdAt DateTime @default(now())

  comment ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId, createdAt])
  @@index([userId, createdAt])
}

model ContentReport {
  id             Int                  @id @default(autoincrement())
  targetType     ModerationTargetType
  targetRecordId Int
  userId         Int
  reason         String?
  status         ReportStatus         @default(open)
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  resolvedById   Int?

  reporter User  @relation("ContentReporter", fields: [userId], references: [id], onDelete: Cascade)
  resolver User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([targetType, targetRecordId, userId])
  @@index([status, createdAt])
  @@index([targetType, targetRecordId])
  @@index([userId])
}

model AdminModerationAction {
  id             Int                  @id @default(autoincrement())
  targetType     ModerationTargetType
  targetRecordId Int
  adminId        Int
  action         ModerationActionType
  reason         String?
  targetSummary  String?
  createdAt      DateTime             @default(now())

  admin User @relation("ModerationActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetRecordId])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

model LineVote {
  id        Int       @id @default(autoincrement())
  lineId    Int
  userId    Int
  value     VoteValue
  createdAt DateTime  @default(now())

  line Line @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lineId, userId])
  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
