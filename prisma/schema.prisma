generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum RiskLevel {
  low
  medium
  high
}

enum LineTag {
  safe
  aggressive
  scramble
}

enum VoteValue {
  up
  down
}

enum CourseStatus {
  pending
  approved
  rejected
}

model User {
  id              Int             @id @default(autoincrement())
  username        String          @unique
  email           String          @unique
  passwordHash    String
  profileImageUrl String?
  isAdmin         Boolean         @default(false)
  createdAt       DateTime        @default(now())

  courseReviews   CourseReview[]
  holeReviews     HoleReview[]
  lines           Line[]
  submittedCourses Course[]       @relation("SubmittedCourses")
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Following")
  lineVotes       LineVote[]
}

model Course {
  id            Int            @id @default(autoincrement())
  name          String
  locationName  String
  latitude      Float?
  longitude     Float?
  coverPhotoUrl String?
  status        CourseStatus   @default(pending)
  submittedById Int?
  createdAt     DateTime       @default(now())

  holes         Hole[]
  reviews       CourseReview[]
  submittedBy   User?          @relation("SubmittedCourses", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
}

model Hole {
  id             Int           @id @default(autoincrement())
  courseId       Int
  holeNumber     Int
  par            Int?
  distanceFeet   Int?
  description    String?
  teePhotoUrl    String?
  teeLat         Float?
  teeLng         Float?
  basketLat      Float?
  basketLng      Float?
  createdAt      DateTime      @default(now())

  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews        HoleReview[]
  lines          Line[]

  @@unique([courseId, holeNumber])
  @@index([courseId])
}

model CourseReview {
  id          Int      @id @default(autoincrement())
  courseId    Int
  userId      Int
  rating      Int
  title       String?
  body        String
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([userId])
}

model HoleReview {
  id        Int      @id @default(autoincrement())
  holeId    Int
  userId    Int
  rating    Int
  title     String?
  body      String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hole      Hole     @relation(fields: [holeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([holeId, createdAt])
  @@index([userId])
}

model Line {
  id             Int        @id @default(autoincrement())
  holeId         Int
  userId         Int
  name           String
  description    String?
  difficulty     Difficulty
  riskLevel      RiskLevel
  tag            LineTag    @default(safe)
  discSuggestion String?
  upvotes        Int        @default(0)
  downvotes      Int        @default(0)
  createdAt      DateTime   @default(now())

  hole           Hole       @relation(fields: [holeId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes          LineVote[]

  @@index([holeId, createdAt])
  @@index([userId])
}

model LineVote {
  id        Int       @id @default(autoincrement())
  lineId    Int
  userId    Int
  value     VoteValue
  createdAt DateTime  @default(now())

  line      Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lineId, userId])
  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
